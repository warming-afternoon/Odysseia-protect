# 将此文件复制为 .env 并填入你的 Bot Token
DISCORD_BOT_TOKEN="YOUR_TOKEN_HERE"

# [安全模式] 用于存放上传文件的私密仓库频道的 ID
WAREHOUSE_CHANNEL_ID="YOUR_WAREHOUSE_CHANNEL_ID_HERE"

# 用于即时同步斜杠命令的服务器 ID
TEST_GUILD_ID="YOUR_GUILD_ID"

# Forward qualifying discussion messages to StellariaPact.
STELLARIA_FORWARDER_ENABLED=true
STELLARIA_DISCUSSION_FORUM_ID="YOUR_DISCUSSION_FORUM_ID"
STELLARIA_EVENT_API_BASE_URL="http://stellaria-pact-api:8765"
STELLARIA_EVENT_API_TOKEN="REPLACE_WITH_A_SHARED_RANDOM_TOKEN"
BOT_BRIDGE_NETWORK="Odysseia-BOT"

# [数据库备份] 定时备份 SQLite 数据库到 S3 兼容对象存储（如 Cloudflare R2）
# BACKUP_ENABLED=false
# BACKUP_ENDPOINT_URL="https://<your-account-id>.r2.cloudflarestorage.com"
# BACKUP_ACCESS_KEY="your-access-key"
# BACKUP_SECRET_KEY="your-secret-key"
# BACKUP_BUCKET_NAME="your-bucket-name"
# BACKUP_REGION_NAME="auto"
