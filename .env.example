# 将此文件复制为 .env 并填写实际配置。
DISCORD_BOT_TOKEN="YOUR_TOKEN_HERE"

# [安全模式] 用于存放上传文件的私密仓库频道的 ID
WAREHOUSE_CHANNEL_ID="YOUR_WAREHOUSE_CHANNEL_ID_HERE"

# 用于即时同步斜杠命令的服务器 ID；也支持 TEST_GUILD_IDS="id1,id2"。
TEST_GUILD_ID="YOUR_GUILD_ID"

# 动态溯源功能总开关。
TRACEABILITY_ENABLED=false
# 32 字节 AES-256-GCM 密钥的 Base64URL 表示，可运行：
# python -m src.traceability.watermark keygen
ODYSSEIA_TRACE_KEY="YOUR_32_BYTE_BASE64URL_KEY_HERE"
ODYSSEIA_TRACE_KEY_ID="v1"

# 溯源管理员：满足角色列表或用户列表任意一个即可。
TRACE_ADMIN_ROLE_IDS="ROLE_ID_1,ROLE_ID_2"
TRACE_ADMIN_USER_IDS="YOUR_DISCORD_USER_ID"

# 溯源用私有 Cloudflare R2（Standard 存储类型）。
R2_ENDPOINT_URL="https://<account-id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="YOUR_R2_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY="YOUR_R2_SECRET_ACCESS_KEY"
R2_BUCKET_NAME="YOUR_PRIVATE_BUCKET"
R2_REGION_NAME="auto"


# 溯源相关配置
TRACE_DOWNLOAD_TTL_SECONDS=1800
TRACE_DELETE_GRACE_SECONDS=300

# redis 配置
REDIS_URL="redis://odysseia-protect-redis:6379/0"

# 转发有效讨论消息到 StellariaPact.
STELLARIA_FORWARDER_ENABLED=true
STELLARIA_DISCUSSION_FORUM_ID="YOUR_DISCUSSION_FORUM_ID"
STELLARIA_EVENT_API_BASE_URL="http://stellaria-pact-api:8765"
STELLARIA_EVENT_API_TOKEN="REPLACE_WITH_A_SHARED_RANDOM_TOKEN"
BOT_BRIDGE_NETWORK="Odysseia-BOT"

# [数据库备份] 定时备份 SQLite 数据库到 S3 兼容对象存储（如 Cloudflare R2）
# BACKUP_ENABLED=false
# BACKUP_ENDPOINT_URL="https://<your-account-id>.r2.cloudflarestorage.com"
# BACKUP_ACCESS_KEY="your-access-key"
# BACKUP_SECRET_KEY="your-secret-key"
# BACKUP_BUCKET_NAME="your-bucket-name"
# BACKUP_REGION_NAME="auto"
